def utc_stamp() -> str:
    return datetime.now(timezone.utc).astimezone().isoformat(timespec="milliseconds")


def sproto_unpack(data: bytes) -> bytes:
    """Decode the ATG SprotoPack byte stream (same framing as 9555.py)."""
    out = bytearray()
    i = 0
    n = len(data)
    while i < n:
        mask = data[i]
        i += 1
        if mask == 0xFF:
            if i >= n:
                raise ValueError("truncated SprotoPack 0xFF block")
            count = (data[i] + 1) * 8
            i += 1
            if i + count > n:
                raise ValueError("truncated SprotoPack raw block")
            out.extend(data[i:i + count])
            i += count
        else:
            for bit in range(8):
                if mask & (1 << bit):
                    if i >= n:
                        raise ValueError("truncated SprotoPack mask block")
                    out.append(data[i])
                    i += 1
                else:
                    out.append(0)
    return bytes(out)


def decode_sproto(data: bytes, offset: int = 0) -> Dict[int, Any]:
    """Decode one Sproto struct. Blob values remain bytes for schema-aware use."""
    if len(data) < offset + 2:
        raise ValueError("Sproto struct shorter than header")
    field_count = struct.unpack_from("<H", data, offset)[0]
    header_start = offset + 2
    body_ptr = header_start + field_count * 2
    if field_count > 4096 or body_ptr > len(data):
        raise ValueError(f"invalid Sproto header field_count={field_count}")

    fields: Dict[int, Any] = {}
    curr_tag = -1
    for index in range(field_count):
        word = struct.unpack_from("<H", data, header_start + index * 2)[0]
        if word == 0:
            curr_tag += 1
            if body_ptr + 4 > len(data):
                raise ValueError("missing Sproto blob length")
            length = struct.unpack_from("<I", data, body_ptr)[0]
            body_ptr += 4
            if length > len(data) - body_ptr:
                raise ValueError("Sproto blob length exceeds packet")
            fields[curr_tag] = data[body_ptr:body_ptr + length]
            body_ptr += length
        elif word == 1:
            curr_tag += 1
            fields[curr_tag] = None
        elif word & 1:
            curr_tag += (word >> 1) + 1
        else:
            curr_tag += 1
            fields[curr_tag] = (word >> 1) - 1
    return fields


def decode_packet(payload: bytes) -> Tuple[Dict[int, Any], Dict[int, Any], Optional[int], Optional[int]]:
    raw = sproto_unpack(payload)
    envelope = decode_sproto(raw, 0)
    header_count = struct.unpack_from("<H", raw, 0)[0]
    body_offset = 2 + header_count * 2
    body = decode_sproto(raw, body_offset) if body_offset < len(raw) else {}
    msg_id = to_int(envelope.get(0))
    session_id = to_int(envelope.get(1))
    return envelope, body, msg_id, session_id


def to_int(value: Any) -> Optional[int]:
    if value is None:
        return None
    if isinstance(value, bool):
        return int(value)
    if isinstance(value, int):
        return value
    if isinstance(value, (bytes, bytearray)):
        raw = bytes(value)
        try:
            text = raw.decode("ascii").strip()
            if text and (text.isdigit() or (text.startswith("-") and text[1:].isdigit())):
                return int(text)
        except UnicodeDecodeError:
            pass
        if len(raw) == 1:
            return raw[0]
        if len(raw) == 4:
            return struct.unpack("<i", raw)[0]
        if len(raw) == 8:
            return struct.unpack("<q", raw)[0]
    return None


def to_text(value: Any) -> Optional[str]:
    if value is None:
        return None
    if isinstance(value, str):
        return value
    if isinstance(value, (bytes, bytearray)):
        try:
            text = bytes(value).decode("utf-8")
            if all(ch.isprintable() or ch in "\r\n\t" for ch in text):
                return text
        except UnicodeDecodeError:
            return None
    return None


def len_prefixed_items(blob: Any) -> List[bytes]:
    if not isinstance(blob, (bytes, bytearray)):
        return []
    data = bytes(blob)
    items: List[bytes] = []
    pos = 0
    while pos + 4 <= len(data):
        size = struct.unpack_from("<I", data, pos)[0]
        pos += 4
        if size > len(data) - pos:
            # A partially decoded/malformed map is still returned as a warning.
            break
        items.append(data[pos:pos + size])
        pos += size
    return items


def display_value(value: Any) -> Any:
    if value is None or isinstance(value, (int, bool, float, str)):
        return value
    if isinstance(value, (bytes, bytearray)):
        text_value = to_text(value)
        if text_value is not None:
            return text_value
        return f"<bytes:{len(value)} hex={bytes(value)[:24].hex()}"
    return repr(value)


def format_fields(fields: Dict[int, Any]) -> str:
    parts = []
    for tag in sorted(fields):
        value = fields[tag]
        if isinstance(value, (bytes, bytearray)):
            raw = bytes(value)
            # Integer fields above 32766 are encoded as 4/8 raw bytes. Prefer
            # printable ASCII strings when present; otherwise show the integer
            # rather than accidentally displaying a valid UTF-8 glyph.
            try:
                ascii_value = raw.decode("ascii")
            except UnicodeDecodeError:
                ascii_value = None
            if ascii_value is not None and ascii_value and all(ch.isprintable() for ch in ascii_value):
                shown = repr(ascii_value)
            elif len(raw) in (1, 4, 8):
                number = to_int(raw)
                shown = f"{number} (integer-bytes)" if number is not None else f"bytes({len(raw)})"
            else:
                try:
                    nested = decode_sproto(raw)
                    shown = f"Sproto(tags={sorted(nested)}, bytes={len(raw)})"
                except Exception:
                    text_value = to_text(raw)
                    shown = repr(text_value) if text_value is not None else f"bytes({len(raw)} hex={raw[:24].hex()})"
        else:
            shown = repr(value)
        parts.append(f"{tag}:{shown}")
    return "{" + ", ".join(parts) + "}"


def unpack_struct_list(blob: Any) -> Tuple[List[Dict[int, Any]], int]:
    raw_items = len_prefixed_items(blob)
    decoded: List[Dict[int, Any]] = []
    for item in raw_items:
        try:
            decoded.append(decode_sproto(item))
        except Exception:
            continue
    return decoded, len(raw_items)


def card_brief(card: Dict[int, Any]) -> Dict[str, Any]:
    general: Dict[int, Any] = {}
    attr_other: Dict[int, Any] = {}
    visual: Dict[int, Any] = {}
    if isinstance(card.get(1), (bytes, bytearray)):
        try:
            general = decode_sproto(bytes(card[1]))
        except Exception:
            pass
    if isinstance(card.get(3), (bytes, bytearray)):
        try:
            attr_other = decode_sproto(bytes(card[3]))
        except Exception:
            pass
    if isinstance(card.get(4), (bytes, bytearray)):
        try:
            visual = decode_sproto(bytes(card[4]))
        except Exception:
            pass
    return {
        "id": to_int(card.get(0)),
        "name": to_text(general.get(0)),
        "profession": to_int(general.get(1)),
        # character_look.attribute_other: level=2, combValue/power=3.
        "client_reads_level": to_int(attr_other.get(2)),
        "client_reads_power": to_int(attr_other.get(3)),
        "client_reads_guild_id": to_int(attr_other.get(5)),
        "general_tags": sorted(general),
        "attribute_other_tags": sorted(attr_other),
        "visual_tags": sorted(visual),
        "has_general": 1 in card,
        "has_attribute_other": 3 in card,
        "has_visual": 4 in card,
    }


class CaptureSnifferState:
    def __init__(self, target_id: int, log_fp, raw_fp):
        self.target_id = target_id
        self.log_fp = log_fp
        self.raw_fp = raw_fp
        self.lock = threading.RLock()
        self.target_active = False
        self.pending_picks: Dict[int, Dict[str, Any]] = {}
        self.pending_requests: Dict[int, Dict[str, Any]] = {}
        self.capture_board_active = False
        self.capture_arena_active = False
        self.capture_returning = False
        self.challenge_pending = False
        self.challenge_map_seen = False
        self.active_district: Optional[str] = None
        self.last_capture_result: Optional[bool] = None
        self.last_map: Optional[str] = None
        self.target_level: Optional[int] = None
        self.arena_map_ready = False
        self.capture_enemy_created = False
        self.capture_fight_started = False
        self.last_board_by_id: Dict[str, Dict[int, Any]] = {}
        self.client_config_printed = False
        self.packet_number = 0
        self.last_reward_request: Optional[Tuple[str, Optional[int], Optional[bool]]] = None

    def log(self, message: str) -> None:
        line = f"[{utc_stamp()}] {message}"
        print(line, flush=True)
        if self.log_fp:
            self.log_fp.write(line + "\n")
            self.log_fp.flush()

    def raw_log(self, direction: str, payload: bytes, msg: Optional[int], session: Optional[int], mode: str) -> None:
        if not self.raw_fp:
            return
        record = {
            "time": utc_stamp(),
            "character_id": self.target_id,
            "direction": direction,
            "mode": mode,
            "message_id": msg,
            "message_name": PROTOCOL_NAMES.get(msg, "unknown") if msg is not None else "rpc_response",
            "session": session,
            "wire_frame_hex": (struct.pack(">H", len(payload)) + payload).hex(),
        }
        self.raw_fp.write(json.dumps(record, separators=(",", ":")) + "\n")
        self.raw_fp.flush()

    def reset_character_filter(self) -> None:
        self.target_active = False
        self.pending_picks.clear()
        self.pending_requests.clear()
        self.capture_board_active = False
        self.capture_arena_active = False
        self.capture_returning = False
        self.challenge_pending = False
        self.challenge_map_seen = False
        self.active_district = None
        self.last_capture_result = None
        self.last_map = None
        self.target_level = None
        self.arena_map_ready = False
        self.capture_enemy_created = False
        self.capture_fight_started = False
        self.last_board_by_id = {}
        self.client_config_printed = False

    def print_client_config(self) -> None:
        if self.client_config_printed:
            return
        self.client_config_printed = True
        self.log("CLIENT ASSET BASELINE (from DominData; local UI/config values, not server packets):")
        self.log(f"  selected_character_level={self.target_level if self.target_level is not None else 'unknown'}")

                f"loss_speed={row['loss_speed']} match_power={row['match_power']}"
            )

    def _log_frame(self, direction: str, payload: bytes, msg: Optional[int], session: Optional[int], body: Dict[int, Any], mode: str) -> None:
        self.packet_number += 1
        if msg is None:
            pending = self.pending_requests.get(session) if session is not None else None
            req_name = PROTOCOL_NAMES.get(pending["msg"], str(pending["msg"])) if pending else "unknown_request"
            self.log(
                f"#{self.packet_number} {direction} RPC_REPLY session={session} "
                f"for={req_name} bytes={len(payload)} body={format_fields(body)} mode={mode}"
            )
        else:
            name = PROTOCOL_NAMES.get(msg, "unknown")
            self.log(
                f"#{self.packet_number} {direction} msg={msg}({name}) session={session} "
                f"bytes={len(payload)} body={format_fields(body)} mode={mode}"
            )
        self.raw_log(direction, payload, msg, session, mode)

    def _validate_domin_board(self, body: Dict[int, Any]) -> None:
        states, raw_state_count = unpack_struct_list(body.get(0))
        cards, raw_card_count = unpack_struct_list(body.get(1))
        state_by_id: Dict[str, Dict[int, Any]] = {}
        duplicate_ids: List[str] = []
        for row in states:
            district_id = to_text(row.get(0))
            if district_id is None:
                numeric_id = to_int(row.get(0))
                district_id = str(numeric_id) if numeric_id is not None else "?"
            if district_id in state_by_id:
                duplicate_ids.append(district_id)
            state_by_id[district_id] = row

        card_by_id: Dict[int, Dict[int, Any]] = {}
        for card in cards:
            card_id = to_int(card.get(0))
            if card_id is not None:
                card_by_id[card_id] = card

        expected = set(CLIENT_DISTRICTS)
        received = set(state_by_id)
        missing = sorted(expected - received, key=lambda x: (not x.isdigit(), x))
        extra = sorted(received - expected)
        warnings: List[str] = []
        if missing:
            warnings.append(f"missing client district IDs={missing}")
        if extra:
            warnings.append(f"unknown district IDs={extra}")
        if duplicate_ids:
            warnings.append(f"duplicate district IDs={duplicate_ids}")
        if raw_state_count != len(states):
            warnings.append(f"malformed state list: {raw_state_count} items, {len(states)} decoded")
        if raw_card_count != len(cards):
            warnings.append(f"malformed character-look list: {raw_card_count} items, {len(cards)} decoded")

        self.log(
            f"CAPTURE BOARD 684: districts={len(states)} character_look_records={len(cards)} "
            f"expected_client_districts={len(expected)}"
        )
        self.last_board_by_id = state_by_id
        for district_id in sorted(received, key=lambda x: (not x.isdigit(), x)):
            row = state_by_id[district_id]
            state = to_int(row.get(8))
            server_id = to_int(row.get(9))
            cfg = CLIENT_DISTRICTS.get(district_id)
            matched = server_id in card_by_id if server_id not in (None, 0) else False
            client_locked = bool(cfg and (cfg["open"] == 0 or (self.target_level is not None and self.target_level < cfg["level_min"])))
            if state not in (0, 1):
                warnings.append(f"district {district_id}: client-visible state={state}; the UI's normal paths are state=0 (challenging) and state=1 (owned/producing); state!=1 can still allow challenge")
            if state == 0 and server_id and not matched and not client_locked:
                warnings.append(f"district {district_id}: serverId={server_id} has no matching character_look record")
            if state == 0 and (not server_id or server_id == 0) and cfg and cfg["open"] and not client_locked:
                warnings.append(f"district {district_id}: serverId=0 cannot link any character_look; client DominRootLogic passes null to DominLineLogic, leaving the row's prefab/default opponent labels")
            if state == 1:
                required_fields = ((1, "max_donmin"), (2, "donmin_time"), (3, "end_time"), (4, "res_time1"), (5, "res_count1"), (6, "res_time2"), (7, "res_count2"), (11, "res_end_time1"), (12, "res_end_time2"))
                for tag, label in required_fields:
                    if tag not in row:
                        warnings.append(f"district {district_id}: state=1 but missing {label} (tag {tag}); owned detail UI reads this value")
                start = to_int(row.get(2))
                end = to_int(row.get(3))
                if start is not None and end is not None and end <= start:
                    warnings.append(f"district {district_id}: owned-state end_time={end} is not after donmin_time={start}; DominLineLogic progress denominator is invalid")
                for idx, count_tag in ((1, 5), (2, 7)):
                    count = to_int(row.get(count_tag))
                    total = cfg[f"total{idx}"] if cfg else None
                    if count is not None and total is not None and (count < 0 or count > total):
                        warnings.append(f"district {district_id}: res_count{idx}={count} outside client DominData total={total}")
                for idx, start_tag, end_tag in ((1, 4, 11), (2, 6, 12)):
                    resource_start = to_int(row.get(start_tag))
                    resource_end = to_int(row.get(end_tag))
                    if resource_start is not None and resource_end is not None and resource_end <= resource_start:
                        warnings.append(f"district {district_id}: resource{idx} end time {resource_end} is not after start {resource_start}; client progress formula divides by this interval")
            if cfg:
                if client_locked:
                    ui_result = "LOCKED by local DominData/level requirement"
                elif state == 0:
                    ui_result = "CHALLENGE shown; opponent card linked" if matched else "CHALLENGE shown; opponent card missing -> prefab/default labels"
                elif state == 1:
                    ui_result = "OWNED; challenge panel hidden; resource production UI shown"
                else:
                    ui_result = f"NONSTANDARD state={state}; row/detail controls may disagree"
            else:
                ui_result = "UNKNOWN district"
            cfg_text = ""
            if cfg:
                cfg_text = f" client_name={cfg['name']} client_type={ENTRY_TYPE_NAMES.get(cfg['entry_type'])} client_open={cfg['open']} client_min_level={cfg['level_min']} client_map={cfg['map']}"
            self.log(
                f"  district={district_id} UI={ui_result} state={state} serverId={server_id} "
                f"character_look_link={'YES' if matched else 'NO'} "
                f"wire_fields={format_fields(row)}{cfg_text}"
            )

        for card in cards:
            brief = card_brief(card)
            self.log(f"  character_look={json.dumps(brief, ensure_ascii=False, sort_keys=True)}")
            # The client displays character_look.general.name and reads
            # attribute_other.level/power in DominInfoRootLogic.
            if not brief["has_general"] or brief["name"] is None:
                warnings.append(f"character_look id={brief['id']} has no general.name (tag 1 -> tag 0)")
            if not brief["has_attribute_other"] or brief["client_reads_level"] is None or brief["client_reads_power"] is None:
                warnings.append(f"character_look id={brief['id']} lacks client-read attribute_other level/power (tag 3 -> tags 2/3)")
            if not brief["has_visual"]:
                warnings.append(f"character_look id={brief['id']} has no visual object (tag 4), which DominInfoRootLogic uses to build the opponent model")
        referenced_ids = {to_int(row.get(9)) for row in states if to_int(row.get(8)) == 0 and to_int(row.get(9)) not in (None, 0)}
        orphan_ids = sorted(set(card_by_id) - referenced_ids)
        if orphan_ids:
            self.log(f"NOTE character_look records not referenced by a free district serverId: {orphan_ids}; client board dictionary will store them but rows may not select them")

        if warnings:
            for warning in dict.fromkeys(warnings):
                self.log(f"VERDICT=WARNING {warning}")
        else:
            self.log("VERDICT=PASS Capture board response matches the visible client structure checks")

        # Strong cross-packet check: after a win, the client expects the board
        # state to reflect ownership; DominInfoRootLogic treats state!=0 as won.
        if self.last_capture_result is True and self.active_district in state_by_id:
            win_state = to_int(state_by_id[self.active_district].get(8))
            if win_state == 0:
                self.log(
                    f"VERDICT=FAIL WIN_STATE_NOT_REFLECTED district={self.active_district}: "
                    "server sent a win result (551 field 0=true), but refreshed 684 still has state=0; "
                    "client will keep the district in the challenge/unowned UI path"
                )
            elif win_state == 1:
                self.log(f"VERDICT=PASS win is reflected by district {self.active_district} state=1")

    def _summarize_reward_popup(self, body: Dict[int, Any]) -> List[Tuple[str, Optional[int]]]:
        entries, raw_count = unpack_struct_list(body.get(0))
        summary: List[Tuple[str, Optional[int]]] = []
        for entry in entries:
            item_id = to_text(entry.get(0))
            amount = to_int(entry.get(1))
            quality = to_int(entry.get(3))
            summary.append((item_id or "?", amount))
            self.log(f"  reward_item id={item_id} amount={amount} quality={quality} fields={format_fields(entry)}")
        if raw_count != len(entries):
            self.log(f"VERDICT=WARNING reward list malformed: raw_items={raw_count} decoded={len(entries)}")
        if self.last_reward_request:
            request_id, request_index, request_cost = self.last_reward_request
            cfg = CLIENT_DISTRICTS.get(request_id)
            if cfg and request_index in (0, 1):
                expected_item = cfg["r1"] if request_index == 0 else cfg["r2"]
                wrong_items = [item for item, _amount in summary if item != expected_item]
                if wrong_items:
                    self.log(
                        f"VERDICT=WARNING reward response contains item(s) {wrong_items} "
                        f"but client requested index={request_index} (expected item {expected_item})"
                    )
            if request_cost:
                self.log("NOTE client request cost=true: this is the client's paid 'Get Now' path; inspect the returned reward popup and currency sync packets")
        return summary

    def observe(self, direction: str, payload: bytes) -> None:
        try:
            _envelope, body, msg, session = decode_packet(payload)
        except Exception as exc:
            # Do not print undecoded packets until the target character is authenticated.
            with self.lock:
                if self.target_active and (self.capture_board_active or self.capture_arena_active or self.capture_returning):
                    self.log(f"DECODE_ERROR direction={direction} bytes={len(payload)} error={exc}")
            return

        with self.lock:
            # Client -> server: identify the actual selected character.
            if direction == "C->S" and msg == 105:
                requested_char_id = to_int(body.get(0))
                if requested_char_id != self.target_id:
                    self.reset_character_filter()
                    return
                if session is not None:
                    self.pending_picks[session] = {"payload": payload, "body": body}
                    self.pending_requests[session] = {"msg": 105, "time": time.time()}
                return

            # Server -> client: activate logging only after server accepted tag 105.
            if direction == "S->C" and msg is None and session is not None and session in self.pending_picks:
                pick = self.pending_picks.pop(session)
                accepted = to_int(body.get(0))
                if accepted == 1:
                    self.target_active = True
                    self.log(f"FILTER ACTIVE: server accepted character_pick; only character_id={self.target_id} will be logged")
                    self._log_frame("C->S", pick["payload"], 105, session, pick["body"], "character-select")
                    self._log_frame("S->C", payload, None, session, body, "character-select")
                    self.pending_requests.pop(session, None)
                return

            if not self.target_active:
                return

            if direction == "C->S":
                # Track only packets in the Capture window. Keeping every game
                # request from the whole session would grow the map indefinitely.
                if (msg is not None and session is not None
                        and (msg in (310, 311, 312) or self.capture_board_active
                             or self.capture_arena_active or self.capture_returning)):
                    self.pending_requests[session] = {"msg": msg, "time": time.time()}
                    if len(self.pending_requests) > 1024:
                        oldest = min(self.pending_requests, key=lambda key: self.pending_requests[key].get("time", 0))
                        self.pending_requests.pop(oldest, None)

                if msg == 310:
                    self.capture_board_active = True
                    self.capture_arena_active = False
                    self.capture_returning = False
                    self.challenge_pending = False
                    self.active_district = None
                    self.last_capture_result = None
                    self.last_reward_request = None
                    self.print_client_config()
                    self.log("CAPTURE UI OPEN: client sent request_domin_info (310); waiting for server push ret_domin_info (684)")
                    self._log_frame(direction, payload, msg, session, body, "capture-board")
                    return

                if msg == 311:
                    district_id = to_text(body.get(0))
                    if district_id is None:
                        district_id = str(to_int(body.get(0)) or "")
                    self.active_district = district_id or None
                    self.challenge_pending = True
                    self.challenge_map_seen = False
                    self.arena_map_ready = False
                    self.capture_enemy_created = False
                    self.capture_fight_started = False
                    self.capture_board_active = False
                    self.capture_arena_active = True
                    district = CLIENT_DISTRICTS.get(district_id)
                    if district:
                        self.log(
                            f"CAPTURE CHALLENGE REQUEST: district={district_id} "
                            f"name={district['name']} expected_map={district['map']} "
                            f"entry_type={ENTRY_TYPE_NAMES.get(district['entry_type'])} open={district['open']}"
                        )
                        if not district["open"] or district["entry_type"] != 0:
                            self.log("VERDICT=FAIL client asset marks this district locked or non-Single; client should not send challenge tag 311")
                        if self.target_level is not None and self.target_level < district["level_min"]:
                            self.log(f"VERDICT=FAIL client level={self.target_level} is below DominData.LevelMin={district['level_min']}; the client should show this row locked and not send challenge tag 311")
                    else:
                        self.log(f"VERDICT=WARNING tag 311 references unknown client district id={district_id!r}")
                    self._log_frame(direction, payload, msg, session, body, "capture-challenge")
                    return

                if msg == 312:
                    district_id = to_text(body.get(0))
                    if district_id is None:
                        district_id = str(to_int(body.get(0)) or "")
                    index = to_int(body.get(1))
                    cost_value = to_int(body.get(2))
                    cost_flag = bool(cost_value) if cost_value is not None else None
                    self.last_reward_request = (district_id, index, cost_flag)
                    self.log(
                        f"CAPTURE RESOURCE REQUEST: district={district_id} index={index} "
                        f"cost={cost_flag} (client request fields: 0=id, 1=index, 2=cost)"
                    )
                    if district_id not in CLIENT_DISTRICTS:
                        self.log("VERDICT=WARNING resource request references unknown client district")
                    if 1 not in body:
                        self.log("VERDICT=WARNING request tag 312 omitted index field 1; client require_domin_rewards schema defines it as required for choosing resource1/resource2")
                    if 2 not in body:
                        self.log("VERDICT=WARNING request tag 312 omitted cost field 2; client schema defines this paid/free choice")
                    if index not in (0, 1):
                        self.log("VERDICT=WARNING resource request index should be 0 or 1")
                    if cost_flag is None:
                        self.log("VERDICT=WARNING request tag 312 cost field could not be decoded as a Boolean")
                    self.capture_board_active = True
                    self._log_frame(direction, payload, msg, session, body, "capture-resource")
                    return

                if msg == 100 and self.capture_returning:
                    self._log_frame(direction, payload, msg, session, body, "capture-return-map-ready")
                    self.log("CAPTURE SESSION COMPLETE: client acknowledged the return map (map_ready 100)")
                    self.capture_arena_active = False
                    self.capture_returning = False
                    self.challenge_pending = False
                    self.challenge_map_seen = False
                    self.arena_map_ready = False
                    self.capture_enemy_created = False
                    self.capture_fight_started = False
                    self.capture_board_active = False
                    self.active_district = None
                    self.last_capture_result = None
                    return

                if msg == 100 and self.capture_arena_active and self.challenge_map_seen:
                    self.arena_map_ready = True
                    self._log_frame(direction, payload, msg, session, body, "capture-arena-map-ready")
                    self.log("CAPTURE ARENA MAP_READY: client confirmed scene initialization; waiting for enemy create (544) and fight start (547)")
                    return

                if self.capture_board_active or self.capture_arena_active or self.capture_returning:
                    mode = "capture-arena" if self.capture_arena_active else ("capture-return" if self.capture_returning else "capture-board")
                    self._log_frame(direction, payload, msg, session, body, mode)
                    return

                # Outside the Capture page, do not log unrelated game traffic.
                return

            # Server -> client, after target character was authenticated.
            if direction == "S->C":
                # Retain the selected player's level from main_player_create so
                # the sniffer can distinguish a real server defect from a row
                # that the client locally locks by DominData.LevelMin.
                if msg == 504 and isinstance(body.get(0), (bytes, bytearray)):
                    try:
                        full_char = decode_sproto(bytes(body[0]))
                        own_attr_other = decode_sproto(bytes(full_char.get(2, b"")))
                        parsed_level = to_int(own_attr_other.get(2))
                        if parsed_level is not None:
                            self.target_level = parsed_level
                    except Exception:
                        pass

                if msg is None and session is not None:
                    pending = self.pending_requests.get(session)
                    if pending and pending["msg"] in (310, 311, 312):
                        req_id = pending["msg"]
                        mode = "capture-resource" if req_id == 312 else ("capture-challenge" if req_id == 311 else "capture-board")
                        self._log_frame(direction, payload, msg, session, body, mode)
                        self.pending_requests.pop(session, None)
                        if req_id == 311 and self.challenge_pending and not self.challenge_map_seen:
                            self.capture_arena_active = False
                            self.challenge_pending = False
                            self.capture_board_active = True
                            self.log("VERDICT=WARNING tag 311 received its RPC reply but no Capture map transition (503) was observed; challenge was likely rejected before entering the arena")
                    elif self.capture_board_active or self.capture_arena_active or self.capture_returning:
                        self._log_frame(direction, payload, msg, session, body, "capture-session")
                        self.pending_requests.pop(session, None)
                    else:
                        self.pending_requests.pop(session, None)
                    return

                if msg == 503:
                    map_id = to_text(body.get(0))
                    if map_id is None:
                        map_id = str(to_int(body.get(0)) or "")
                    previous_map = self.last_map
                    self.last_map = map_id
                    if self.challenge_pending:
                        expected_map = CLIENT_DISTRICTS.get(self.active_district or "", {}).get("map")
                        if map_id == expected_map:
                            self.challenge_map_seen = True
                            self.capture_arena_active = True
                            self.capture_returning = False
                            self.log(f"VERDICT=PASS challenge entered expected Capture arena map={map_id} district={self.active_district}")
                        elif map_id in CAPTURE_MAP_IDS:
                            self.log(f"VERDICT=FAIL challenge district={self.active_district} expected map={expected_map}, but server entered Capture map={map_id}")
                            self.challenge_map_seen = False
                        else:
                            self.log(f"VERDICT=WARNING challenge pending but server sent non-Capture map={map_id}; expected={expected_map}")
                    elif self.capture_arena_active and map_id not in CAPTURE_MAP_IDS:
                        self.capture_returning = True
                        self.log(f"CAPTURE RETURN TRANSITION: server sent map={map_id} after arena map={previous_map}")
                    if self.capture_board_active or self.capture_arena_active or self.capture_returning or map_id in CAPTURE_MAP_IDS:
                        self._log_frame(direction, payload, msg, session, body, "capture-map-transition")
                        return

                if msg == 544 and self.capture_arena_active:
                    self.capture_enemy_created = True
                    enemy_blob = body.get(0)
                    enemy_summary = {}
                    if isinstance(enemy_blob, (bytes, bytearray)):
                        try:
                            enemy = decode_sproto(bytes(enemy_blob))
                            enemy_summary["id"] = to_int(enemy.get(0))
                            if isinstance(enemy.get(1), (bytes, bytearray)):
                                eg = decode_sproto(bytes(enemy[1]))
                                enemy_summary["name"] = to_text(eg.get(0))
                                enemy_summary["profession"] = to_int(eg.get(1))
                            if isinstance(enemy.get(2), (bytes, bytearray)):
                                enemy_attr = decode_sproto(bytes(enemy[2]))
                                enemy_summary["level"] = to_int(enemy_attr.get(2))
                                enemy_summary["power"] = to_int(enemy_attr.get(3))
                                enemy_summary["attribute_other_tags"] = sorted(enemy_attr)
                            if isinstance(enemy.get(6), (bytes, bytearray)):
                                enemy_visual = decode_sproto(bytes(enemy[6]))
                                enemy_summary["visual_tags"] = sorted(enemy_visual)
                            enemy_summary["fields"] = sorted(enemy)
                        except Exception as exc:
                            enemy_summary["decode_error"] = str(exc)
                    self.log(f"CAPTURE ENEMY CREATE 544: {json.dumps(enemy_summary, ensure_ascii=False, sort_keys=True)}")
                    if not enemy_blob:
                        self.log("VERDICT=WARNING tag 544 has no character payload; client may have no opponent model to display")
                    self._log_frame(direction, payload, msg, session, body, "capture-enemy-create")
                    return

                if msg == 547 and self.capture_arena_active:
                    self.capture_fight_started = True
                    self.log(f"CAPTURE FIGHT START 547: enemy_create_seen={self.capture_enemy_created} map_ready_seen={self.arena_map_ready}")
                    if not self.capture_enemy_created:
                        self.log("VERDICT=WARNING fight-start push arrived without a preceding Capture enemy-create push 544")
                    self._log_frame(direction, payload, msg, session, body, "capture-fight-start")
                    return

                if msg == 629 and (self.capture_arena_active or self.capture_returning):
                    deadline = to_int(body.get(0))
                    timer_state = to_int(body.get(1))
                    self.log(f"CAPTURE TIMER 629: end_time={deadline} state={timer_state} fields={format_fields(body)}")
                    if deadline is None or timer_state is None:
                        self.log("VERDICT=WARNING timer push missing client-read end_time/state fields")
                    self._log_frame(direction, payload, msg, session, body, "capture-timer")
                    return

                if msg == 551:
                    result_value = to_int(body.get(0))
                    self.last_capture_result = bool(result_value) if result_value is not None else None
                    result_name = "WIN" if result_value == 1 else ("LOSS" if result_value == 0 else "UNKNOWN")
                    if self.capture_arena_active or self.challenge_pending or self.active_district:
                        self.log(f"CAPTURE RESULT 551: {result_name} district={self.active_district} body={format_fields(body)}")
                        self._log_frame(direction, payload, msg, session, body, "capture-result")
                        if result_value == 1:
                            self.log("NOTE after WIN, the next 684 response should set this district's domin_info.state to 1 for the client's owned/producing UI path")
                        return

                if msg == 684:
                    if self.capture_board_active or self.capture_arena_active or self.capture_returning or self.active_district:
                        self._log_frame(direction, payload, msg, session, body, "capture-board-response")
                        self._validate_domin_board(body)
                        return

                if msg == 638 and (self.capture_board_active or self.capture_arena_active or self.capture_returning):
                    self.log("CAPTURE REWARD POPUP 638:")
                    self._log_frame(direction, payload, msg, session, body, "capture-reward-popup")
                    self._summarize_reward_popup(body)
                    return

                if msg == 529 and (self.capture_board_active or self.capture_arena_active or self.capture_returning):
                    self.log(f"CAPTURE NOTICE 529: text={to_text(body.get(0))!r} flag={to_int(body.get(1))}")
                    self._log_frame(direction, payload, msg, session, body, "capture-notice")
                    return

                if self.capture_board_active or self.capture_arena_active or self.capture_returning:
                    mode = "capture-arena" if self.capture_arena_active else ("capture-return" if self.capture_returning else "capture-board")
                    self._log_frame(direction, payload, msg, session, body, mode)


class FrameObserver:
    """Incremental 2-byte length-prefixed frame parser; forwards are never altered."""
    def __init__(self, state: CaptureSnifferState, direction: str):
        self.state = state
        self.direction = direction
        self.buffer = bytearray()
        self.mode = "unknown"

    def feed(self, data: bytes) -> None:
        if self.mode == "http":
            return
        self.buffer.extend(data)
        if len(self.buffer) > MAX_BUFFER_SIZE:
            self.state.log(f"PARSER RESET direction={self.direction}: buffered data exceeded {MAX_BUFFER_SIZE}; relay remains unmodified") if self.state.target_active else None
            self.buffer.clear()
            self.mode = "opaque"
            return
        if self.mode == "unknown":
            probe = bytes(self.buffer[:8])
            if any(method.startswith(probe) for method in HTTP_METHOD_PREFIXES) and len(probe) < max(map(len, HTTP_METHOD_PREFIXES)):
                return
            if any(probe.startswith(method) for method in HTTP_METHOD_PREFIXES):
                self.mode = "http"
                self.buffer.clear()
                return
            if len(self.buffer) < 2:
                return
            self.mode = "sproto"
        if self.mode != "sproto":
            return

        while len(self.buffer) >= 2:
            frame_size = struct.unpack_from(">H", self.buffer, 0)[0]
            if frame_size == 0 or frame_size > MAX_FRAME_SIZE:
                self.mode = "opaque"
                self.buffer.clear()
                return
            if len(self.buffer) < frame_size + 2:
                return
            payload = bytes(self.buffer[2:2 + frame_size])
            del self.buffer[:2 + frame_size]
            self.state.observe(self.direction, payload)


class ClientHandler:
    def __init__(self, client: socket.socket, address, backend: Tuple[str, int], target_id: int, log_fp, raw_fp):
        self.client = client
        self.address = address
        self.backend = backend
        self.state = CaptureSnifferState(target_id, log_fp, raw_fp)
        self.backend_socket: Optional[socket.socket] = None
        self.close_lock = threading.Lock()
        self.closed = False

    def close_all(self) -> None:
        with self.close_lock:
            if self.closed:
                return
            self.closed = True
            for sock in (self.client, self.backend_socket):
                if sock:
                    try:
                        sock.shutdown(socket.SHUT_RDWR)
                    except OSError:
                        pass
                    try:
                        sock.close()
                    except OSError:
                        pass

    def relay(self, source: socket.socket, destination: socket.socket, direction: str, observer: FrameObserver) -> None:
        try:
            while True:
                chunk = source.recv(65536)
                if not chunk:
                    break
                # Observe before forwarding so character_pick is registered before
                # the backend can answer. Parsing is fail-open: a diagnostic bug
                # must never drop or alter the game's byte stream.
                try:
                    observer.feed(chunk)
                except Exception as parse_error:
                    observer.buffer.clear()
                    observer.mode = "opaque"
                    if self.state.target_active:
                        self.state.log(f"PARSER DISABLED direction={direction} after diagnostic error: {parse_error}; forwarding remains byte-for-byte")
                destination.sendall(chunk)
        except (ConnectionError, OSError):
            pass
        finally:
            self.close_all()

    def run(self) -> None:
        try:
            print(
                f"[{utc_stamp()}] CLIENT ACCEPTED peer={self.address[0]}:{self.address[1]} "
                f"backend={self.backend[0]}:{self.backend[1]}",
                flush=True,
            )
            self.backend_socket = socket.create_connection(self.backend, timeout=10)
            print(
                f"[{utc_stamp()}] BACKEND CONNECTED peer={self.address[0]}:{self.address[1]} "
                f"backend={self.backend[0]}:{self.backend[1]}",
                flush=True,
            )
            self.backend_socket.settimeout(None)
            self.client.settimeout(None)
            for sock in (self.client, self.backend_socket):
                try:
                    sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
                    sock.setsockopt(socket.SOL_SOCKET, socket.SO_KEEPALIVE, 1)
                except OSError:
                    pass
            c2s = FrameObserver(self.state, "C->S")
            s2c = FrameObserver(self.state, "S->C")
            t1 = threading.Thread(target=self.relay, args=(self.client, self.backend_socket, "C->S", c2s), daemon=True)
            t2 = threading.Thread(target=self.relay, args=(self.backend_socket, self.client, "S->C", s2c), daemon=True)
            t1.start()
            t2.start()
            t1.join()
            t2.join()
        except Exception as exc:
            # Connection diagnostics are printed even before character selection,
            # so a failed backend connect cannot look like a silent game timeout.
            print(
                f"[{utc_stamp()}] CONNECTION FAILED peer={self.address[0]}:{self.address[1]} "
                f"backend={self.backend[0]}:{self.backend[1]} "
                f"error={type(exc).__name__}: {exc}",
                flush=True,
            )
            if self.state.target_active:
                self.state.log(f"[AtgSniffer] backend/relay error for target character {self.state.target_id}: {exc}")
        finally:
            self.close_all()


def parse_endpoint(value: str) -> Tuple[str, int]:
    if ":" not in value:
        raise argparse.ArgumentTypeError("endpoint must be HOST:PORT")
    host, port_text = value.rsplit(":", 1)
    try:
        port = int(port_text)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("port must be an integer") from exc
    if not host or not 1 <= port <= 65535:
        raise argparse.ArgumentTypeError("endpoint must have a host and port 1..65535")
    return host, port


def main() -> int:
    parser = argparse.ArgumentParser(description="Read-only ATG Capture protocol sniffer (transparent TCP proxy)")
    parser.add_argument("--listen", default="0.0.0.0:15678", type=parse_endpoint, help="public proxy endpoint HOST:PORT")
    parser.add_argument("--server", default="127.0.0.1:14171", type=parse_endpoint, help="local 9555.py backend HOST:PORT")
    parser.add_argument("--target", type=int, default=DEFAULT_TARGET_CHAR_ID, help="only log this confirmed character ID")
    parser.add_argument("--log-file", default="AtgSniffer_capture.log", help="human-readable log file")
    parser.add_argument("--raw-log", default="AtgSniffer_packets.jsonl", help="full raw frames for the target character during Capture; use empty string to disable")
    args = parser.parse_args()

    log_fp = open(args.log_file, "a", encoding="utf-8", buffering=1) if args.log_file else None
    raw_fp = open(args.raw_log, "a", encoding="utf-8", buffering=1) if args.raw_log else None
    listen_host, listen_port = args.listen
    backend_host, backend_port = args.server

    server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    server.bind((listen_host, listen_port))
    server.listen(50)
    print("=" * 72, flush=True)
    print("ATG CAPTURE SNIFFER - READ ONLY TCP PROXY", flush=True)
    print(f"Listen : {listen_host}:{listen_port}", flush=True)
    print(f"Backend: {backend_host}:{backend_port}", flush=True)
    print("Routing: client-facing port stays 15678; backend must be the 9555.py listener on 14171.", flush=True)
    print(f"Filter : confirmed character_id={args.target}", flush=True)
    print(f"Text log: {os.path.abspath(args.log_file)}", flush=True)
    print(f"Raw log : {os.path.abspath(args.raw_log)}", flush=True)
    print("No server source/data files are modified. Reconnect the game client through the listen port.", flush=True)
    print("=" * 72, flush=True)

    try:
        while True:
            client, address = server.accept()
            handler = ClientHandler(client, address, (backend_host, backend_port), args.target, log_fp, raw_fp)
            threading.Thread(target=handler.run, daemon=True).start()
    except KeyboardInterrupt:
        print("\n[AtgSniffer] stopping", flush=True)
    finally:
        try:
            server.close()
        except OSError:
            pass
        if log_fp:
            log_fp.close()
        if raw_fp:
            raw_fp.close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
